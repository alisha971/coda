# ============================================================
# CODA Research Project - .gitignore
# ============================================================

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Python virtual environments
.venv/
venv/
env/
ENV/
.env/
.python-version

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# -------------------------
# Environment & secrets
# -------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.secret
secrets/
credentials/
config.local.*
settings.local.*

# -------------------------
# Jupyter
# -------------------------
.ipynb_checkpoints/
*.nbconvert.ipynb

# -------------------------
# IDE / editor files
# -------------------------
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.DS_Store

# -------------------------
# OS files
# -------------------------
Thumbs.db
Desktop.ini
.DS_Store

# -------------------------
# Logs
#
# Scratch logs are ignored, but run logs stored beside a result are provenance:
# they record which split each fit used and which configuration produced it.
# -------------------------
*.log
logs/
!results/**/*.log
!outputs/**/*.log
!runs/**/*.log

# -------------------------
# Test / coverage artifacts
# -------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
coverage.html
nosetests.xml
pytestdebug.log

# -------------------------
# Experiment outputs
#
# Experiment results are research evidence, not disposable build output.
# Every reported number must trace to a stored run artifact, and every figure
# must be regenerable from stored results, so results/, outputs/, runs/,
# artifacts/ and generated figures are TRACKED.
#
# Only tool-managed directories and large binaries stay ignored. The binary
# extension rules further down (*.pt, *.npy, *.pkl, *.parquet, ...) act as the
# size guard inside tracked result directories. To track one such file
# deliberately, stage it with: git add -f <path>
# -------------------------
checkpoints/
tensorboard/
wandb/
mlruns/

# -------------------------
# ML model artifacts
#
# Anchored to the repository root so that src/models/ — which holds the ridge,
# reduced-rank ridge, variance model and the neural architecture source — stays
# tracked. An unanchored "models/" matches at any depth and would silently
# untrack the project's estimator code.
# -------------------------
/models/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.bin

# -------------------------
# Audio / video / temporary media
# -------------------------
*.wav
*.flac
*.mp3
*.m4a
*.ogg
*.aac
*.mp4
*.avi
*.mov
*.mkv

# -------------------------
# Large datasets / downloaded corpora
#
# Anchored to the repository root so that src/data/ — the information firewall,
# split builder and pair constructor — stays tracked.
# -------------------------
/data/
/datasets/
/corpora/
/downloads/
/cache/
.cache/

# Common dataset/archive formats
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.npz
*.npy

# Archives / extracted source packages
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# -------------------------
# Hugging Face / ML caches
# -------------------------
.huggingface/
huggingface/
transformers_cache/
hf_cache/

# -------------------------
# Speech / audio processing caches
# -------------------------
*.rttm
*.ctm
*.TextGrid
*.lab
alignment_cache/
# Anchored so that src/features/ — prosody extraction, the frozen text encoder
# and the normalisation-statistics module — stays tracked.
/features/
/embeddings/

# -------------------------
# Temporary / scratch files
# -------------------------
tmp/
temp/
scratch/
*.tmp
*.bak
*.orig

# -------------------------
# Local research / internal configuration
# These are machine- or workflow-specific and should not be
# required for someone else to understand the research.
# -------------------------
.claude/
CODA_PREFERENCES.md
**/CLAUDE.md
**/SKILL.md
**/skills/
CODA_MASTER_SPECIFICATION.md
CODA_v3_with_neural_layer.md

# Implementation-control documents: build plans, task breakdowns and working
# notes guide implementation rather than constituting the research artifact.
CODA_IMPLEMENTATION_PLAN.md
docs/internal/
TODO.md
NOTES.md
CODA_GIT_COMMANDS.md
CODA_COLAB_RUNBOOK.md
docs/decision_log.md

# Keep the human-readable Git command reference tracked.
# CODA_GIT_COMMANDS.md

# -------------------------
# Local databases / caches
# -------------------------
*.db
*.sqlite
*.sqlite3

# -------------------------
# Platform-specific experiment files
# -------------------------
.DVC/
.dvc/cache/

# -------------------------
# Future generated documentation
# Ignore only clearly generated/local documentation artifacts;
# normal .md research documents remain tracked.
# -------------------------
site/
docs/_build/
